# Copy to .env (gitignored) and adjust.
# Windows and macOS: 50000 is fine. Linux: use the output of `id -u`.
AIRFLOW_UID=50000
# Password for the local data Postgres (D-051). Local only.
DATA_PG_PASSWORD=change-me
# Encrypts connection passwords in the Airflow metadata DB (AD-040). Generate with:
# docker run --rm apache/airflow:3.3.2 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
